# MISTRAL_API_KEY: Required for Mistral AI API calls.
# Get a free key at https://console.mistral.ai
MISTRAL_API_KEY="your_mistral_api_key_here"

# TAVILY_API_KEY: Required for Live Web Search backend.
# Get a free key at https://tavily.com (1000 free searches/mo)
TAVILY_API_KEY="your_tavily_key_here"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the service URL.
APP_URL="MY_APP_URL"
