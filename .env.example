# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# TAVILY_API_KEY: Required for Live Web Search backend.
# Get a free key at https://tavily.com (1000 free searches/mo)
TAVILY_API_KEY="your_tavily_key_here"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the service URL.
APP_URL="MY_APP_URL"
